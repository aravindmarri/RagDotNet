<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Let the test/eval project reach the internal Rag types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RagDotNet.Tests" />
  </ItemGroup>

  <!-- The test project is a nested folder; keep its files out of this app's build. -->
  <ItemGroup>
    <Compile Remove="RagDotNet.Tests\**" />
    <Content Remove="RagDotNet.Tests\**" />
    <EmbeddedResource Remove="RagDotNet.Tests\**" />
    <None Remove="RagDotNet.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
  </ItemGroup>

  <!-- Ship the documents next to the app so they load from a published build too. -->
  <ItemGroup>
    <None Include="docs\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
